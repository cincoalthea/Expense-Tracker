<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExpenseTracker.WelcomePage"
             Title="Welcome">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24" VerticalOptions="Center">
            <Label Text="Welcome to ExpenseTracker"
                   FontSize="30"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />

            <Label Text="Track your spending, build better habits, and grow your financial confidence."
                   FontSize="16"
                   HorizontalTextAlignment="Center" />

            <Button Text="Start"
                    FontSize="18"
                    Clicked="OnStartClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
